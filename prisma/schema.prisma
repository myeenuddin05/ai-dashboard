generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  company     String?
  status      String   @default("active") // active, inactive, lead
  value       Float    @default(0)
  notes       String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  histories   ClientHistory[]
  events      Event[]
}

model ClientHistory {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  action      String   // created, updated, contacted, deal_closed, note_added
  description String
  metadata    String?  // JSON string for extra data
  createdAt   DateTime @default(now())
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  source      String   @default("website") // website, referral, linkedin, conference, email
  status      String   @default("new") // new, contacted, qualified, converted, lost
  score       Int      @default(50) // 0-100
  value       Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo") // todo, in_progress, review, done
  category    String   @default("general") // content, sales, event, general
  priority    String   @default("medium") // low, medium, high, urgent
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reminder {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  isRead      Boolean  @default(false)
  priority    String   @default("medium") // low, medium, high
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Content {
  id          String   @id @default(cuid())
  title       String
  body        String   @default("")
  type        String   @default("social_media") // newsletter, social_media, blog, ad_copy, event_content
  platform    String   @default("linkedin") // linkedin, twitter, instagram, email, blog
  status      String   @default("draft") // draft, scheduled, published
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("meeting") // meeting, webinar, conference, campaign
  location    String   @default("virtual")
  status      String   @default("scheduled") // scheduled, in_progress, completed, cancelled
  startDate   DateTime
  endDate     DateTime?
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id          String   @id @default(cuid())
  title      String
  type       String   @default("weekly") // weekly, monthly
  metrics    String   @default("{}") // JSON string for metrics data
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
}

model Activity {
  id          String   @id @default(cuid())
  type        String   // created, updated, completed, deleted
  entity      String   // client, lead, task, content, event, reminder
  entityId    String?
  description String
  createdAt   DateTime @default(now())
}
