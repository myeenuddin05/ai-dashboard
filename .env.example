# ============================================
#  AI Provider Configuration
# ============================================
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_MODEL=google/gemma-3-4b-it:free
AI_MAX_TOKENS=800
AI_TEMPERATURE=0.7

# ============================================
#  Database — Supabase PostgreSQL
# ============================================
# Get this from Supabase: Project Settings → Database → Connection string
# Use "Transaction" mode pooler (port 6543) for serverless
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:6543/postgres?pgbouncer=true"

# For Prisma migrate/seed (direct connection, port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres"
