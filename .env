# ============================================
#  AI Provider Configuration
#  Pick ONE — uncomment the provider you want
# ============================================

AI_PROVIDER=openrouter

# ── OpenRouter (Gemma 3 4B - free) ──────────
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Free models: google/gemma-3-4b-it:free, meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL=google/gemma-3-4b-it:free

# ── Hugging Face (free tier) ─────────────────
# Get token: https://huggingface.co/settings/tokens
# AI_PROVIDER=huggingface
# HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxx
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── Ollama (local, free) ─────────────────────
# Install: https://ollama.com
# AI_PROVIDER=ollama
# OLLAMA_API_KEY=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── OpenAI ───────────────────────────────────
# Get key: https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (free tier available) ─────
# Get key: https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.0-flash


# ============================================
#  Advanced Options
# ============================================

# Max tokens per response
AI_MAX_TOKENS=800

# Temperature (0 = precise, 1 = creative)
AI_TEMPERATURE=0.7
